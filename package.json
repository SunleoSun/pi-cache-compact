{
  "name": "pi-cache-compact-preserved-messages",
"version": "1.2.1",
  "description": "Cache-friendly Pi compaction that preserves historical user messages and completed assistant responses verbatim.",
  "type": "module",
  "license": "MIT",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "node --test test/e2e.test.ts",
    "certify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run certify"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "compaction",
    "prompt-cache",
    "llama.cpp"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
